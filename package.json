{
  "name": "kwin-floating-window-tiling",
  "version": "0.0.5",
  "main": "src/main.ts",
  "description": "Tiling using floating windows like older GNOME 2 style",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pyamsoft/kwin-floating-window-tiling",
  "author": {
    "email": "developer.pyamsoft+kde@gmail.com",
    "name": "pyamsoft"
  },
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types buildsystem/build.ts",
    "clean": "rm -rf dist",
    "lint:eslint": "eslint --report-unused-disable-directives --max-warnings 0 --cache --cache-strategy content .",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:tsc": "tsc --strict --noEmit",
    "lint": "$npm_execpath run lint:oxlint && $npm_execpath run lint:tsc && $npm_execpath run lint:eslint",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.x"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "npm-check-updates": "23.1.1",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
